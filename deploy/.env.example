# deploy/.env 로 복사해서 값을 채운다 — .env는 커밋하지 않는다(.gitignore). 서버에만 둔다.
# 사이트 주소: 무료 주소 예) 13-54-12-34.sslip.io (서버 공인 IP의 점을 -로) → Caddy가 HTTPS 인증서를 자동 발급
#             로컬 확인) http://localhost (포트 없이) 와 함께 HTTP_PORT=8088 HTTPS_PORT=8443 → 브라우저는 http://localhost:8088
SITE_ADDRESS=
HTTP_PORT=80
HTTPS_PORT=443
# DB 비밀번호 — 긴 임의 문자열 (예: openssl rand -base64 32)
POSTGRES_PASSWORD=
# JWT 서명 키 — 32바이트 이상 임의 문자열 (예: openssl rand -base64 48). 로컬 .env와 다른 값으로
JWT_SECRET=
# Claude API 키(AI 챗봇) · 공공데이터 특일 정보 키(공휴일) — 없으면 그 기능만 꺼진다
ANTHROPIC_API_KEY=
HOLIDAY_API_KEY=
